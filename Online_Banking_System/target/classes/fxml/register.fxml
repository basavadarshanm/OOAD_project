<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.onlinebanking.controller.RegisterController" style="-fx-background-color: linear-gradient(to right, #1e3c72, #2a5298);">
    <center>
        <VBox spacing="20" alignment="CENTER">
            <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
            
            <!-- Main Card Container -->
            <VBox spacing="18" style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5); -fx-min-width: 450;">
                
                <!-- Header -->
                <VBox spacing="5" alignment="CENTER">
                    <Label text="📝" style="-fx-font-size: 35px;" />
                    <Label text="CREATE YOUR ACCOUNT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3c72;" />
                    <Label text="Join our secure banking platform" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" />
                </VBox>
                
                <!-- Registration Form -->
                <VBox spacing="12">
                    <TextField fx:id="usernameField" promptText="Username" styleClass="text-field" />
                    <TextField fx:id="fullNameField" promptText="Full Name" styleClass="text-field" />
                    <TextField fx:id="emailField" promptText="Email Address" styleClass="text-field" />
                    <TextField fx:id="phoneField" promptText="Phone Number" styleClass="text-field" />
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field" />
                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" styleClass="password-field" />
                </VBox>
                
                <!-- Action Buttons -->
                <VBox spacing="10">
                    <Button text="CREATE ACCOUNT" onAction="#handleRegister" style="-fx-padding: 14 20; -fx-background-color: linear-gradient(to right, #1e3c72, #2a5298); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-radius: 6; -fx-cursor: hand; -fx-border-width: 0;" />
                    <Button text="Back to Login" onAction="#handleBackToLogin" styleClass="button-secondary" style="-fx-padding: 12 20;" />
                </VBox>
                
                <!-- Messages -->
                <Label fx:id="messageLabel" textFill="red" wrapText="true" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-alignment: center;" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
